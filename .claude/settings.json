{
  "agentPushNotifEnabled": true,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "agmsg@fujibee-agmsg": true,
    "compact-plus@compact-plus": true,
    "pixelbrowse@pixelrag-plugins": true,
    "ruby-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5"
  },
  "extraKnownMarketplaces": {
    "compact-plus": {
      "source": {
        "repo": "u-ichi/compact-plus",
        "source": "github"
      }
    },
    "fujibee-agmsg": {
      "source": {
        "repo": "fujibee/agmsg",
        "source": "github"
      }
    },
    "pixelrag-plugins": {
      "source": {
        "repo": "StarTrail-org/PixelRAG",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "claude-opus-4-7",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "$HOME/.claude/scripts/statusline.sh",
    "type": "command"
  },
  "useAutoModeDuringPlan": true
}
