{
  "agentPushNotifEnabled": true,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "agmsg@fujibee-agmsg": true,
    "codex@openai-codex": true,
    "compact-plus@compact-plus": true,
    "ruby-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5"
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "repo": "anthropics/claude-plugins-community",
        "source": "github"
      }
    },
    "compact-plus": {
      "source": {
        "repo": "u-ichi/compact-plus",
        "source": "github"
      }
    },
    "fujibee-agmsg": {
      "source": {
        "repo": "fujibee/agmsg",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"$HOME/.claude/scripts/doc-lint-hook.sh\" ] || \"$HOME/.claude/scripts/doc-lint-hook.sh\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "Japanese",
  "model": "opus",
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
